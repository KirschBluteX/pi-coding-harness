{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/input-context-v1-activation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module", "epoch", "activation_level", "activation_basis", "effectiveness_verdict", "verdict", "generated_at", "config_contract_sha256", "source_closure_sha256", "runtime", "inputs", "sources", "checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "module": { "const": "INPUT_CONTEXT" },
    "epoch": { "type": "string", "minLength": 1 },
    "activation_level": { "const": "AUTO_GUARDED" },
    "activation_basis": { "enum": ["MATCHED_PROMOTION", "USER_EXPLICIT_UNVALIDATED"] },
    "effectiveness_verdict": { "enum": ["PASS", "NOT_EVALUATED"] },
    "verdict": { "const": "PASS" },
    "generated_at": { "type": "string", "format": "date-time" },
    "config_contract_sha256": { "$ref": "#/$defs/sha256" },
    "source_closure_sha256": { "$ref": "#/$defs/sha256" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_version", "node_major", "platform", "arch", "pi_version", "pi_git_head", "pi_package_sha256", "pi_extension_types_sha256", "pi_extension_runner_sha256", "pi_agent_session_sha256", "pi_sdk_sha256", "pi_system_prompt_types_sha256", "migration_sha256"],
      "properties": {
        "node_version": { "type": "string", "minLength": 1 },
        "node_major": { "type": "integer", "minimum": 22 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "pi_version": { "type": "string", "minLength": 1 },
        "pi_git_head": { "type": ["string", "null"], "minLength": 7 },
        "pi_package_sha256": { "$ref": "#/$defs/sha256" },
        "pi_extension_types_sha256": { "$ref": "#/$defs/sha256" },
        "pi_extension_runner_sha256": { "$ref": "#/$defs/sha256" },
        "pi_agent_session_sha256": { "$ref": "#/$defs/sha256" },
        "pi_sdk_sha256": { "$ref": "#/$defs/sha256" },
        "pi_system_prompt_types_sha256": { "$ref": "#/$defs/sha256" },
        "migration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/binding" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/binding" }, "minItems": 1, "uniqueItems": true },
    "checks": { "type": "object", "additionalProperties": { "const": true }, "minProperties": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "activation_basis": { "const": "MATCHED_PROMOTION" } }, "required": ["activation_basis"] },
      "then": { "properties": { "effectiveness_verdict": { "const": "PASS" } } }
    },
    {
      "if": { "properties": { "activation_basis": { "const": "USER_EXPLICIT_UNVALIDATED" } }, "required": ["activation_basis"] },
      "then": { "properties": { "effectiveness_verdict": { "const": "NOT_EVALUATED" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}
