{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/read-evidence-receipt.schema.json",
  "title": "PCH Input Context v1 read evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "workspace_id", "subject", "source_kind", "capture_kind", "evidence_sha256", "artifact_ref_hmac", "dependency_signature_sha256", "source_scope_hmac", "source_version_handle_hmac", "query_completeness", "content_freshness", "scope_authorization", "semantic_applicability", "representation_fidelity", "classification", "adapter_version", "observed_at_ms", "receipt_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "$ref": "input-context-common.schema.json#/$defs/id" },
    "workspace_id": { "$ref": "input-context-common.schema.json#/$defs/id" },
    "subject": { "$ref": "input-context-common.schema.json#/$defs/executionSubjectRef" },
    "source_kind": { "$ref": "input-context-common.schema.json#/$defs/sourceKind" },
    "capture_kind": { "enum": ["FULL_FILE", "BYTE_RANGE", "LINE_RANGE", "QUERY_SCOPE", "TOOL_OUTPUT", "IMMUTABLE_ARTIFACT", "STRUCTURAL_EXTRACT"] },
    "evidence_sha256": { "$ref": "input-context-common.schema.json#/$defs/sha256" },
    "artifact_ref_hmac": { "$ref": "input-context-common.schema.json#/$defs/nullableSha256" },
    "dependency_signature_sha256": { "$ref": "input-context-common.schema.json#/$defs/sha256" },
    "source_scope_hmac": { "$ref": "input-context-common.schema.json#/$defs/sha256" },
    "source_version_handle_hmac": { "$ref": "input-context-common.schema.json#/$defs/nullableSha256" },
    "query_completeness": { "enum": ["COMPLETE", "PARTIAL", "NOT_APPLICABLE", "UNKNOWN"] },
    "content_freshness": { "$ref": "input-context-common.schema.json#/$defs/contentFreshness" },
    "scope_authorization": { "$ref": "input-context-common.schema.json#/$defs/scopeAuthorization" },
    "semantic_applicability": { "$ref": "input-context-common.schema.json#/$defs/semanticApplicability" },
    "representation_fidelity": { "$ref": "input-context-common.schema.json#/$defs/representationFidelity" },
    "classification": { "$ref": "input-context-common.schema.json#/$defs/classification" },
    "adapter_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
    "observed_at_ms": { "$ref": "input-context-common.schema.json#/$defs/nonNegativeInteger" },
    "receipt_sha256": { "$ref": "input-context-common.schema.json#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "source_kind": { "const": "QUERY" } }, "required": ["source_kind"] },
      "then": { "properties": { "capture_kind": { "const": "QUERY_SCOPE" } } },
      "else": { "properties": { "capture_kind": { "not": { "const": "QUERY_SCOPE" } }, "query_completeness": { "const": "NOT_APPLICABLE" } } }
    }
  ]
}
