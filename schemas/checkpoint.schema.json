{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/checkpoint.schema.json",
  "title": "PCH MilestoneCheckpoint or ProgressSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "goal_id",
    "goal_version",
    "event_sequence",
    "reason",
    "created_at",
    "protected_state",
    "protected_state_sha256",
    "prev_checkpoint_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "record_type": { "enum": ["MILESTONE_CHECKPOINT", "PROGRESS_SNAPSHOT"] },
    "record_id": { "$ref": "#/$defs/id" },
    "goal_id": { "$ref": "#/$defs/id" },
    "goal_version": { "type": "integer", "minimum": 1 },
    "event_sequence": { "type": "integer", "minimum": 1 },
    "reason": {
      "enum": [
        "CAPABILITY_PROBE",
        "ASSUMPTION_CHANGED",
        "SCHEMA_FROZEN",
        "PLAN_FROZEN",
        "STAGE_EXIT",
        "FIRST_END_TO_END",
        "BLOCKER_CHANGED",
        "ROUTE_CHANGED",
        "VALIDATION_RESULT",
        "DO_NOT_REPEAT_RECORDED",
        "PRE_COMPACTION",
        "LONG_PAUSE",
        "ENVIRONMENT_CHANGE",
        "PERIODIC_EVENT_BOUND"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "protected_state": { "$ref": "#/$defs/protectedState" },
    "protected_state_sha256": { "$ref": "#/$defs/sha256" },
    "prev_checkpoint_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "record_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "protectedState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "acceptance_contract",
        "constraints",
        "latest_correction",
        "assumptions",
        "requirement_revision",
        "plan_revision",
        "execution_phase",
        "current_stage",
        "next_action",
        "pending_effects",
        "receipts",
        "failure_signatures",
        "route_decision",
        "active_performance_trial",
        "prompt_generation",
        "prompt_request",
        "cache_lineage",
        "response_contract",
        "evidence_frontier",
        "lease_generation"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "acceptance_contract": { "$ref": "#/$defs/ref" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "latest_correction": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "assumptions": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "requirement_revision": { "$ref": "#/$defs/nullableRef" },
        "plan_revision": { "$ref": "#/$defs/nullableRef" },
        "execution_phase": { "enum": ["CLARIFYING", "SPECIFYING", "PLANNING", "BUILDING", "VERIFYING", "TERMINAL"] },
        "current_stage": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "next_action": { "type": "string", "minLength": 1 },
        "pending_effects": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "receipts": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "failure_signatures": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "route_decision": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "active_performance_trial": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "prompt_generation": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "prompt_request": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "cache_lineage": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "response_contract": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
        "evidence_frontier": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "lease_generation": { "type": "integer", "minimum": 1 }
      }
    },
    "nullableRef": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }
  }
}
