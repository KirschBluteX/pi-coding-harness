{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/receipt.schema.json",
  "title": "PCH immutable receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "goal_id",
    "receipt_type",
    "subject_type",
    "subject_id",
    "attempt_id",
    "result",
    "input_closure_sha256",
    "output_sha256",
    "artifacts",
    "evidence",
    "issued_at",
    "issuer",
    "event_sequence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "$ref": "#/$defs/id" },
    "goal_id": { "$ref": "#/$defs/id" },
    "receipt_type": {
      "enum": [
        "INTAKE",
        "REQUIREMENT_VALIDATION",
        "REQUIREMENT_FREEZE",
        "PLAN_VALIDATION",
        "PLAN_FREEZE",
        "EXECUTION",
        "VALIDATION",
        "EFFECT_INTENT",
        "EFFECT_OUTCOME",
        "DECISION",
        "CHECKPOINT",
        "RECOVERY",
        "DELIVERY"
      ]
    },
    "subject_type": { "enum": ["GOAL", "REQUIREMENT", "PLAN", "STAGE", "WORK_ITEM", "ATTEMPT", "EFFECT", "DECISION", "CHECKPOINT", "ARTIFACT"] },
    "subject_id": { "$ref": "#/$defs/id" },
    "attempt_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "result": { "enum": ["SUCCEEDED", "FAILED", "BLOCKED", "UNKNOWN_OUTCOME", "WAIVED"] },
    "input_closure_sha256": { "$ref": "#/$defs/sha256" },
    "output_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceRef" } },
    "failure_signature": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "issued_at": { "type": "string", "format": "date-time" },
    "issuer": { "enum": ["RUNTIME", "TOOL_ADAPTER", "VALIDATOR", "USER"] },
    "event_sequence": { "type": "integer", "minimum": 1 },
    "caveats": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256", "locator"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "locator": { "type": "string", "pattern": "^pch-cas://sha256/[a-f0-9]{64}$" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "sha256"],
      "properties": {
        "kind": { "enum": ["TOOL_RESULT", "VALIDATOR_REPORT", "TARGET_READBACK", "USER_DECISION", "RUNTIME_PROBE"] },
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
