{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/acceptance.schema.json",
  "title": "PCH acceptance contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_id", "goal", "hard_constraints", "criteria"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "contract_id": { "$ref": "#/$defs/id" },
    "goal": { "$ref": "#/$defs/nonEmpty" },
    "hard_constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,127}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "class",
        "required",
        "evidence",
        "implementation_phases",
        "review_gates",
        "tests",
        "blueprint_sections"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "class": { "enum": ["FUNCTIONAL", "AUTHORITY", "SAFETY", "PRIVACY", "PERFORMANCE", "UX", "MIGRATION", "DOCUMENTATION"] },
        "required": { "const": true },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["STATIC", "DETERMINISTIC", "INTEGRATION", "LIVE_TRANSPORT", "MATCHED_EXPERIMENT", "USER_ACCEPTANCE"] }
        },
        "implementation_phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "review_gates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "blueprint_sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    }
  }
}
