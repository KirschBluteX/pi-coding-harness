{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/context-working-set.schema.json",
  "title": "PCH Input Context v1 working set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "working_set_id", "subject", "profile", "context_demand_sha256", "retained_root_sha256", "source_closure_root_sha256", "acceptance_closure_root_sha256", "items", "created_at_ms", "record_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "working_set_id": { "$ref": "input-context-common.schema.json#/$defs/id" },
    "subject": { "$ref": "input-context-common.schema.json#/$defs/executionSubjectRef" },
    "profile": { "$ref": "input-context-common.schema.json#/$defs/contextProfile" },
    "context_demand_sha256": { "$ref": "input-context-common.schema.json#/$defs/sha256" },
    "retained_root_sha256": { "$ref": "input-context-common.schema.json#/$defs/sha256" },
    "source_closure_root_sha256": { "$ref": "input-context-common.schema.json#/$defs/nullableSha256" },
    "acceptance_closure_root_sha256": { "$ref": "input-context-common.schema.json#/$defs/nullableSha256" },
    "items": { "type": "array", "items": { "$ref": "input-context-common.schema.json#/$defs/contextIrItem" }, "maxItems": 4096 },
    "created_at_ms": { "$ref": "input-context-common.schema.json#/$defs/nonNegativeInteger" },
    "record_sha256": { "$ref": "input-context-common.schema.json#/$defs/sha256" }
  }
}
