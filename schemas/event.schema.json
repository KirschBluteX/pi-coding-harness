{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/event.schema.json",
  "title": "PCH immutable event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "goal_id",
    "sequence",
    "event_type",
    "command_id",
    "idempotency_key_sha256",
    "actor",
    "occurred_at_ms",
    "payload",
    "payload_sha256",
    "prev_event_sha256",
    "event_sha256",
    "store_generation",
    "leader_epoch"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/id" },
    "goal_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": {
      "enum": [
        "GOAL_ADMITTED",
        "GOAL_CORRECTED",
        "REQUIREMENT_PROPOSED",
        "REQUIREMENT_VALIDATED",
        "REQUIREMENT_FROZEN",
        "REQUIREMENT_SUPERSEDED",
        "REQUIREMENT_ITEM_RECORDED",
        "PLAN_PROPOSED",
        "PLAN_VALIDATED",
        "PLAN_FROZEN",
        "PLAN_SUPERSEDED",
        "BUILD_STARTED",
        "STAGE_AUTHORIZED",
        "STAGE_TRANSITIONED",
        "WORK_ITEM_STARTED",
        "ATTEMPT_RECORDED",
        "ASSUMPTION_RECORDED",
        "ASSUMPTION_REFUTED",
        "RECEIPT_ATTACHED",
        "EFFECT_PREPARED",
        "EFFECT_RECONCILED",
        "PLAN_HEALTH_EVALUATED",
        "ROUTE_DECIDED",
        "DEPENDENCY_INVALIDATED",
        "DECISION_REQUESTED",
        "DECISION_RESOLVED",
        "MILESTONE_CHECKPOINTED",
        "PROGRESS_SNAPSHOTTED",
        "COMPACTION_PREPARED",
        "COMPACTION_VERIFIED",
        "LEASE_ACQUIRED",
        "LEASE_RENEWED",
        "LEASE_RELEASED",
        "GOAL_TRANSITIONED",
        "MEMORY_VERSIONED",
        "EXPERIMENT_EPOCH_CHANGED"
      ]
    },
    "command_id": { "$ref": "#/$defs/id" },
    "idempotency_key_sha256": { "$ref": "#/$defs/sha256" },
    "actor": { "enum": ["USER", "AGENT", "RUNTIME", "VALIDATOR"] },
    "occurred_at_ms": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" },
    "payload_sha256": { "$ref": "#/$defs/sha256" },
    "prev_event_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "event_sha256": { "$ref": "#/$defs/sha256" },
    "store_generation": { "type": "integer", "minimum": 1 },
    "leader_epoch": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
