{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/performance-sample.schema.json",
  "title": "PCH performance baseline or candidate sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "experiment_epoch_id", "metric_scope", "sample_role", "trial_id", "workload_id", "metric_id", "pair_id", "sample_index", "order_in_pair", "arm", "task_class", "runtime_fingerprint", "measurements", "quality_gate", "recorded_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "sample_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "experiment_epoch_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "metric_scope": { "enum": ["RUNTIME_OVERHEAD", "TARGET_PROJECT", "CACHE", "OUTPUT", "MEMORY", "COMPACTION"] },
    "sample_role": { "enum": ["BASELINE", "CANDIDATE", "OBSERVATION"] },
    "trial_id": { "type": ["string", "null"], "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "workload_id": { "type": ["string", "null"], "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "metric_id": { "type": ["string", "null"], "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "pair_id": { "type": ["string", "null"], "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "sample_index": { "type": "integer", "minimum": 0 },
    "order_in_pair": { "enum": ["BASELINE_FIRST", "CANDIDATE_FIRST", "NOT_PAIRED"] },
    "arm": { "enum": ["NATIVE_PI", "PCH_BYPASS", "PCH_LIGHT", "PCH_STANDARD", "PCH_FULL", "CACHE_C0", "CACHE_C1_PREFIX", "CACHE_C2_PROVIDER", "CACHE_C3_RETENTION", "OUTPUT_BASELINE", "OUTPUT_GOVERNED", "TARGET_BASELINE", "TARGET_CANDIDATE"] },
    "task_class": { "enum": ["PURE_CONVERSATION", "SHORT_READ", "SHORT_WRITE", "MEDIUM_MULTI_FILE", "LONG_RECOVERABLE", "COMPACTION", "RECOVERY", "PERFORMANCE_TRIAL", "CACHE_WARM", "OUTPUT_RESPONSE"] },
    "runtime_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_requests", "input_tokens", "cache_read_tokens", "cache_write_tokens", "output_tokens", "reasoning_tokens", "ttft_ms", "wall_ms", "tool_start_delay_ms", "pch_sync_ms", "user_questions", "usage_completeness", "cache_state", "eligible_cacheable_prefix_tokens", "response_directive_input_tokens", "tool_context_tokens", "rendered_output_chars", "artifact_bytes", "suppressed_progress_events", "duplicate_output_tokens_estimate", "first_pass_acceptance_closed", "omission_followup_count", "reopen_count"],
      "properties": {
        "provider_requests": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
        "wall_ms": { "type": "number", "minimum": 0 },
        "tool_start_delay_ms": { "type": ["number", "null"], "minimum": 0 },
        "pch_sync_ms": { "type": "number", "minimum": 0 },
        "user_questions": { "type": "integer", "minimum": 0 },
        "usage_completeness": { "enum": ["COMPLETE", "PARTIAL", "UNOBSERVABLE"] },
        "cache_state": { "type": ["string", "null"], "enum": ["INELIGIBLE", "COLD_START", "HIT", "MISS", "UNOBSERVABLE", "ERROR", null] },
        "eligible_cacheable_prefix_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "response_directive_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "tool_context_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "rendered_output_chars": { "type": ["integer", "null"], "minimum": 0 },
        "artifact_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "suppressed_progress_events": { "type": ["integer", "null"], "minimum": 0 },
        "duplicate_output_tokens_estimate": { "type": ["integer", "null"], "minimum": 0 },
        "first_pass_acceptance_closed": { "type": ["boolean", "null"] },
        "omission_followup_count": { "type": ["integer", "null"], "minimum": 0 },
        "reopen_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "quality_gate": { "enum": ["PASS", "FAIL", "NOT_EVALUATED"] },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
