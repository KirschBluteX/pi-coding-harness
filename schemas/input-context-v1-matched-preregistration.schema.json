{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/input-context-v1-matched-preregistration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "module", "epoch", "status", "frozen_at", "analysis_population",
    "runtime_fingerprints", "pairs", "inclusion_rules_sha256", "exclusion_rules_sha256",
    "quality_validators_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "module": { "const": "INPUT_CONTEXT" },
    "epoch": { "const": "INPUT-CONTEXT-V1-MATCHED-001" },
    "status": { "const": "FROZEN" },
    "frozen_at": { "type": "string", "format": "date-time" },
    "analysis_population": { "const": "ALL_PREREGISTERED_VALID_PAIRS" },
    "runtime_fingerprints": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "pairs": {
      "type": "array", "minItems": 30,
      "items": { "$ref": "#/$defs/pairIdentity" }
    },
    "inclusion_rules_sha256": { "$ref": "#/$defs/sha256" },
    "exclusion_rules_sha256": { "$ref": "#/$defs/sha256" },
    "quality_validators_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pairIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["pair_id", "family_id_hmac", "split", "order", "runtime_fingerprint_sha256"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1 },
        "family_id_hmac": { "$ref": "#/$defs/sha256" },
        "split": { "enum": ["CALIBRATION", "HOLDOUT"] },
        "order": { "enum": ["BASELINE_THEN_CANDIDATE", "CANDIDATE_THEN_BASELINE"] },
        "runtime_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
