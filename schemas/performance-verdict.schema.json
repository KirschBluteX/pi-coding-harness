{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-coding-harness.local/schemas/performance-verdict.schema.json",
  "title": "PCH target-project PerformanceTrial verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict_id", "trial_id", "sequence", "analysis_population", "sample_set_sha256", "statistics_sha256", "estimates", "gates", "verdict", "reason", "recorded_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "verdict_id": { "$ref": "#/$defs/id" },
    "trial_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "analysis_population": { "const": "ALL_PREDECLARED_VALID_PAIRS" },
    "sample_set_sha256": { "$ref": "#/$defs/sha256" },
    "statistics_sha256": { "$ref": "#/$defs/sha256" },
    "estimates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workload_id", "workload_role", "metric_id", "pair_count", "baseline_point", "candidate_point", "point", "lower", "upper", "unit", "confidence_level", "method"],
        "properties": {
          "workload_id": { "$ref": "#/$defs/id" },
          "workload_role": { "enum": ["PRIMARY", "REGRESSION", "HOLDOUT"] },
          "metric_id": { "$ref": "#/$defs/id" },
          "pair_count": { "type": "integer", "minimum": 1 },
          "baseline_point": { "type": "number" },
          "candidate_point": { "type": "number" },
          "point": { "type": "number" },
          "lower": { "type": "number" },
          "upper": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "confidence_level": { "type": "number", "minimum": 0.9, "maximum": 0.999 },
          "method": { "enum": ["PROJECT_NATIVE", "PAIRED_BOOTSTRAP", "PAIRED_NONPARAMETRIC"] }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correctness", "confidence", "practical_effect", "end_to_end", "regression", "holdout", "benefit_horizon", "environment", "budget"],
      "properties": {
        "correctness": { "$ref": "#/$defs/gate" },
        "confidence": { "$ref": "#/$defs/gate" },
        "practical_effect": { "$ref": "#/$defs/gate" },
        "end_to_end": { "$ref": "#/$defs/gate" },
        "regression": { "$ref": "#/$defs/gate" },
        "holdout": { "$ref": "#/$defs/gate" },
        "benefit_horizon": { "$ref": "#/$defs/gate" },
        "environment": { "$ref": "#/$defs/gate" },
        "budget": { "$ref": "#/$defs/gate" }
      }
    },
    "verdict": { "enum": ["PROMOTE", "REJECT", "NEED_MORE_EVIDENCE", "CANCELED"] },
    "reason": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "PROMOTE" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "gates": {
            "type": "object",
            "properties": {
              "correctness": { "const": "PASS" },
              "confidence": { "const": "PASS" },
              "practical_effect": { "const": "PASS" },
              "end_to_end": { "const": "PASS" },
              "regression": { "const": "PASS" },
              "holdout": { "const": "PASS" },
              "benefit_horizon": { "const": "PASS" },
              "environment": { "const": "PASS" },
              "budget": { "const": "PASS" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gate": { "enum": ["PASS", "FAIL", "INSUFFICIENT", "NOT_APPLICABLE"] }
  }
}
